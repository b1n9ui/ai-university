{
  "id": "c2-surface",
  "title": "旋转曲面的面积",
  "subtitle": "圆周长度乘上一小段弧长",
  "concept": "旋转侧面积把每段小弧转成窄带：窄带面积约为圆周长乘弧长。",
  "intuition": "体积用圆盘，表面积用圆周。两者的小块不同，不能交换公式。",
  "body": [
    {
      "title": "为什么有弧长因子？",
      "text": "曲线斜着走，小弧比水平宽度长。必须用 $ds=\\sqrt{1+(f\\prime)^2}dx$，而不是直接用 $dx$。"
    },
    {
      "title": "半径取哪个量？",
      "text": "半径是点到旋转轴的距离。绕水平轴 $y=c$ 旋转时，用 $|f(x)-c|$。"
    },
    {
      "title": "是否包含端盖？",
      "text": "本公式给侧面积，不含两端封口。若题目要封闭表面的总面积，再加相应端盖；重复描线会重复计数。"
    }
  ],
  "formalDefinition": {
    "text": "圆周长度乘上一小段弧长",
    "latex": "S=2\\pi\\int_a^b|f(x)-c|\\sqrt{1+f\\prime(x)^2}\\,dx",
    "conditions": [
      "$f$ 在 $[a,b]$ 连续可导，绕 $y=c$ 旋转，曲面不重复计算；这里只算侧面积。"
    ]
  },
  "derivation": [
    {
      "text": "把小弧近似成线段。",
      "latex": "\\Delta s\\approx\\sqrt{(\\Delta x)^2+(\\Delta y)^2}"
    },
    {
      "text": "每个旋转窄带近似圆台侧带。",
      "latex": "\\Delta S\\approx2\\pi|f(x)-c|\\Delta s"
    },
    {
      "text": "细分并取极限。",
      "latex": "S=2\\pi\\int_a^b|f(x)-c|\\sqrt{1+f\\prime(x)^2}dx"
    }
  ],
  "workedExamples": [
    {
      "title": "圆锥的侧面",
      "problem": "$y=x$，$0\\leq x\\leq1$ 绕横轴旋转，侧面积？",
      "steps": [
        "半径为 $x$，$ds=\\sqrt2 dx$。",
        "$S=2\\pi\\sqrt2\\int_0^1x dx=\\pi\\sqrt2$。"
      ],
      "answer": "$\\pi\\sqrt2$；不含底面。"
    },
    {
      "title": "圆柱",
      "problem": "$y=2$，$0\\leq x\\leq3$ 绕横轴旋转，侧面积？",
      "steps": [
        "半径为 2，弧长微元就是 $dx$。",
        "$S=2\\pi\\int_0^3 2dx$，与圆周长乘高一致。"
      ],
      "answer": "$12\\pi$。"
    }
  ],
