{
  "type": "object",
  "required": [
    "id",
    "number",
    "chapterId",
    "title",
    "concept",
    "intuition",
    "objectives",
    "body",
    "formalDefinition",
    "derivation",
    "workedExamples",
    "practice",
    "commonMistakes",
    "learningCheck",
    "interactiveVisual",
    "prerequisites",
    "difficulty",
    "misconceptionTags",
    "sources",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^c-[a-z0-9-]+$"
    },
    "number": {
      "type": "string",
      "minLength": 1
    },
    "chapterId": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "concept": {
      "type": "string",
      "minLength": 1
    },
    "intuition": {
      "type": "string",
      "minLength": 1
    },
    "objectives": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "body": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "title",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "formalDefinition": {
      "type": "object",
      "required": [
        "text",
        "conditions"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "conditions": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "derivation": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "workedExamples": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "title",
          "problem",
          "steps",
          "answer"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "problem": {
            "type": "string",
            "minLength": 1
          },
          "steps": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "answer": {
            "type": "object",
            "required": [
              "code",
              "stdin",
              "stdout",
              "files",
              "exitCode"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "stdin": {
                "type": "string"
              },
              "stdout": {
                "type": "string"
              },
              "stderr": {
                "type": "string"
              },
              "files": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "exitCode": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "practice": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "problem",
          "hint",
          "solution",
          "answer",
          "difficulty",
          "misconceptionTags"
        ],
        "additionalProperties": false,
        "properties": {
          "problem": {
            "type": "string",
            "minLength": 1
          },
          "hint": {
            "type": "string",
            "minLength": 1
          },
          "solution": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "answer": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "required": [
                  "code",
                  "stdin",
                  "stdout",
                  "files",
                  "exitCode"
                ],
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "stdin": {
                    "type": "string"
                  },
                  "stdout": {
                    "type": "string"
                  },
                  "stderr": {
                    "type": "string"
                  },
                  "files": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "exitCode": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            ]
          },
          "difficulty": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "misconceptionTags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "commonMistakes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "claim",
          "correction",
          "tag"
        ],
        "additionalProperties": false,
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "correction": {
            "type": "string",
            "minLength": 1
          },
          "tag": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "learningCheck": {
      "type": "object",
      "required": [
        "question",
        "choices",
        "correctIndex",
        "feedback"
      ],
      "additionalProperties": false,
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "choices": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 3
        },
        "correctIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "feedback": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 3
        }
      }
    },
    "interactiveVisual": {
      "type": "object",
      "required": [
        "mode",
        "prediction",
        "caption",
        "experiment"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "c-compare"
        },
        "prediction": {
          "type": "string",
          "minLength": 1
        },
        "caption": {
          "type": "string",
          "minLength": 1
        },
        "experiment": {
          "type": "object",
          "required": [
            "code",
            "stdin",
            "stdout",
            "files",
            "exitCode"
          ],
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "stdin": {
              "type": "string"
            },
            "stdout": {
              "type": "string"
            },
            "stderr": {
              "type": "string"
            },
            "files": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "exitCode": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "prerequisites": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "misconceptionTags": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 2
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "author",
        "humanReviewed",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "author": {
          "const": "AI-generated"
        },
        "humanReviewed": {
          "const": false
        },
        "version": {
          "const": "0.1.0"
        }
      }
    },
    "setup": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "text",
          "commands",
          "expected"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "commands": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
