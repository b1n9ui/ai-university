{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "chapterId",
    "number",
    "title",
    "subtitle",
    "concept",
    "intuition",
    "objectives",
    "body",
    "formalDefinition",
    "workflow",
    "workedExamples",
    "commonMistakes",
    "practice",
    "learningCheck",
    "interactiveVisual",
    "prerequisites",
    "difficulty",
    "misconceptionTags",
    "sources",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "chapterId": {
      "type": "string",
      "minLength": 1
    },
    "number": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[1-9][0-9]*\\.[1-9][0-9]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string",
      "minLength": 1
    },
    "concept": {
      "type": "string",
      "minLength": 1
    },
    "intuition": {
      "type": "string",
      "minLength": 1
    },
    "objectives": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "body": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "text"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "formalDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "conditions"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "workflow": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "workedExamples": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "problem",
          "steps",
          "answer"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "problem": {
            "type": "string",
            "minLength": 1
          },
          "steps": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "answer": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "commonMistakes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "correction"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "correction": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "practice": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "difficulty",
          "problem",
          "hint",
          "answer",
          "solution"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "difficulty": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "problem": {
            "type": "string",
            "minLength": 1
          },
          "hint": {
            "type": "string",
            "minLength": 1
          },
          "answer": {
            "type": "string",
            "minLength": 1
          },
          "solution": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "learningCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "choices",
        "correctIndex",
        "feedback"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "choices": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 3,
          "uniqueItems": true
        },
        "correctIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "feedback": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 3
        }
      }
    },
    "interactiveVisual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "prediction",
        "steps",
        "followUp"
      ],
      "properties": {
        "kind": {
          "enum": [
            "decision",
            "git",
            "prompt"
          ]
        },
        "prediction": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question",
              "choices",
              "correctIndex",
              "feedback"
            ],
            "properties": {
              "question": {
                "type": "string",
                "minLength": 1
              },
              "choices": {
                "type": "array",
                "minItems": 3,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "maxItems": 3,
                "uniqueItems": true
              },
              "correctIndex": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2
              },
              "feedback": {
                "type": "array",
                "minItems": 3,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "maxItems": 3
              }
            }
          }
        },
        "followUp": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "prerequisites": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "misconceptionTags": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "author",
        "version",
        "status",
        "humanReviewed"
      ],
      "properties": {
        "author": {
          "const": "AI-generated"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "first-edition",
            "revised"
          ]
        },
        "humanReviewed": {
          "const": false
        }
      }
    },
    "promptTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal",
        "context",
        "scope",
        "acceptance",
        "verification",
        "delivery"
      ],
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "acceptance": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "type": "string",
          "minLength": 1
        },
        "delivery": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI-assisted development contribution lesson"
}
