{
  "name": "ai-university",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "AI-authored open textbooks with static interactive mathematics.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "validate:content": "node scripts/validate-content.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/*.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "build": "npm run validate:content && npm run typecheck && node scripts/build-book.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "npm run build && npm test",
    "content:scaffold": "node scripts/scaffold-lesson.mjs",
    "build:ai-development": "node drafts/ai-development/tools/validate.mjs && node drafts/ai-development/tools/build.mjs",
    "check:ai-development": "node drafts/ai-development/tools/validate.mjs && node --test drafts/ai-development/tools/git-lab.test.mjs && npm test --prefix drafts/ai-development/project && node drafts/ai-development/tools/build.mjs --check"
  },
  "dependencies": {
    "katex": "^0.19.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/katex": "^0.16.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "ajv": "^8.17.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "@types/three": "^0.186.0"
  }
}
